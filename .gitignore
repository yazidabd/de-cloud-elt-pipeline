# OS/editor
.DS_Store
.vscode/

# hasil extract lokal, bukan kode, gak perlu ditrack
extractor/landing/

# koneksi dbt, ada credential di dalamnya
dbt_project/profiles.yml

# credential Airtable
.env.airtable

# state file order id counter, generated lokal
extractor/order_id_counter.txt

# Airflow local runtime state, bukan kode
airflow/airflow.cfg
airflow/airflow.db
airflow/airflow.db-shm
airflow/airflow.db-wal
airflow/logs/
