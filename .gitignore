secrets/
*.p8
*.pem
.env

# virtual environment tiap komponen
venv/
*/venv/
__pycache__/
*.pyc

# terraform state dan cache, isinya bisa ngandung data sensitif (state file)
.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl

# dbt
dbt_project/target/
dbt_project/dbt_packages/
